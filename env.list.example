# Local secrets and settings for swarmchase. Copy to env.list (gitignored) and
# fill in what you need; leave the rest commented out.
#
# Load it for one command:     scripts/with-env.sh cargo run -p swarmchase -- watch
# Or into your current shell:  source scripts/with-env.sh
#
# Format: KEY=value, one per line, like `docker run --env-file`. Values are
# taken literally (no quotes, no $expansion); blank lines and # comments are
# ignored. A variable already set in the environment wins over this file.
#
# In CI these come from repository secrets instead (see .github/workflows/watch.yml).

# urlquery.net API key (urlquery sources, `collect urlquery`, `collect urlquery-reports`).
#URLQUERY_APIKEY=

# urlscan.io API key (optional; raises the quota of `collect urlscan`).
#URLSCAN_APIKEY=

# Email for watch digests and alerts (scripts/ci/send-mail.sh).
#SMTP_URL=smtps://smtp.example.com:465
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM=
#MAIL_TO=

# Where `watch` keeps its state and record store (default: data/).
#SWARMCHASE_DATA=

# The admin name `case new` records for a case (default: `git config user.name`).
# A second review must come from someone else.
#SWARMCHASE_ADMIN=

# Encrypted backups (`swarmchase backup create`): where they go, and the age
# public key they are encrypted to (from `swarmchase backup keygen`; the
# identity file itself never goes on the runner). The passphrase is the
# alternative to a recipient.
#SWARMCHASE_BACKUP_DIR=
#SWARMCHASE_BACKUP_RECIPIENT=
#SWARMCHASE_BACKUP_PASSPHRASE=

# Override the collectors' User-Agent.
#SWARMCHASE_UA=

# Label suggestions in `swarmchase review --suggest`: a model running locally,
# OpenAI-compatible. Loopback, private or link-local hosts only; anything else
# is refused, so records never reach a third-party API.
#SWARMCHASE_LLM_URL=http://127.0.0.1:8080
#SWARMCHASE_LLM_MODEL=
